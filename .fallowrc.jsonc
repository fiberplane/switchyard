{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "workspaces": {
    "patterns": ["apps/*", "packages/*", "playgrounds/*"],
  },
  "entry": [
    "scripts/**/*.{ts,js,cjs,mjs}",
    "*.{config,config.*}.{ts,js,mjs,cjs}",
    "*.config.{ts,js,mjs,cjs}",
    "*.json",
    "*.toml",
    "apps/*/package.json",
    "apps/*/tsconfig.json",
    "packages/*/package.json",
    "packages/*/tsconfig.json",
    "playgrounds/*/package.json",
    "playgrounds/*/tsconfig.json",
    "apps/symphony-orchestrator/src/index.ts",
    "apps/symphony-orchestrator/snapshot/build.ts",
    "apps/symphony-orchestrator/test/**/*.{test,spec}.{ts,tsx,js,jsx,mjs,cjs}",
    "packages/qa/src/**/*.{test,spec}.{ts,tsx,js,jsx,mjs,cjs}",
    "packages/qa/src/remote-daytona-e2e.ts",
    "playgrounds/symphony-daytona-playground/src/**/*.{ts,js,cjs,mjs}",
    "**/*.{test,spec}.{ts,tsx,js,jsx,mjs,cjs}",
    "**/__tests__/**/*.{ts,tsx,js,jsx,mjs,cjs}",
  ],
  "ignorePatterns": [
    "**/*.d.ts",
    "**/dist/**",
    "**/out/**",
    "**/build/**",
    "**/coverage/**",
    "**/node_modules/**",
    "**/.codex/**",
    "**/.fallow/**",
    "**/.fp/**",
    "**/.symphony/**",
    "**/artifacts/**",
    "**/codex-home/**",
    "apps/symphony-orchestrator/src/runner/protocol/**",
    "apps/symphony-orchestrator/src/runner/.codegen-stamp.json",
    "references/**",
  ],
  "ignoreDependencies": ["bun", "bun:test"],
  "duplicates": {
    "minOccurrences": 3,
    "ignore": [
      "**/*.test.{ts,tsx,js,jsx,mjs,cjs}",
      "**/__tests__/**",
      "**/__fixtures__/**",
      "**/fixtures/**",
      "**/test-helpers/**",
      "apps/symphony-orchestrator/src/runner/protocol/**",
      "references/**",
    ],
  },
  "health": {
    "ignore": [
      "**/*.test.{ts,tsx,js,jsx,mjs,cjs}",
      "**/__tests__/**",
      "**/test-helpers/**",
      "apps/symphony-orchestrator/src/runner/protocol/**",
      "references/**",
    ],
  },
  "rules": {
    "unused-files": "warn",
    "unused-exports": "warn",
    "unused-types": "warn",
    "private-type-leaks": "warn",
    "unused-dependencies": "warn",
    "unused-dev-dependencies": "warn",
    "unused-optional-dependencies": "warn",
    "unused-enum-members": "warn",
    "unused-class-members": "warn",
    "unresolved-imports": "warn",
    "unlisted-dependencies": "warn",
    "duplicate-exports": "warn",
    "type-only-dependencies": "warn",
    "test-only-dependencies": "warn",
    "circular-dependencies": "warn",
    "re-export-cycle": "warn",
    "boundary-violation": "off",
    "coverage-gaps": "off",
    "feature-flags": "off",
    "stale-suppressions": "warn",
    "unused-catalog-entries": "warn",
    "empty-catalog-groups": "warn",
    "unresolved-catalog-references": "warn",
    "unused-dependency-overrides": "warn",
    "misconfigured-dependency-overrides": "warn",
  },
}
