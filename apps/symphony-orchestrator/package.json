{
  "name": "@switchyard/symphony-orchestrator",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "EFFECT_TRACE=1 bun run src/index.ts",
    "dispatch": "EFFECT_TRACE=${EFFECT_TRACE:-1} LOG_LEVEL=${LOG_LEVEL:-debug} bun run src/index.ts -- --workflow \"${INIT_CWD:-$PWD}/WORKFLOW.md\" 2>&1 | tee \"${ORCHESTRATOR_LOG:-/tmp/orchestrator.log}\"",
    "format": "oxfmt --write src/ test/",
    "format:check": "oxfmt --check src/ test/",
    "lint": "oxlint src/ test/",
    "test": "bun test",
    "snapshot:build": "bun run snapshot/build.ts",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@daytona/sdk": "0.171.0",
    "@effect/platform": "0.95.0",
    "@effect/platform-bun": "0.85.0",
    "@effect/platform-node": "0.105.0",
    "effect": "3.20.0",
    "yaml": "2.8.4"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "bun-types": "1.3.13"
  }
}
