{
  "name": "@switchyard/symphony-orchestrator",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "EFFECT_TRACE=1 bun run src/index.ts",
    "format": "oxfmt --write src/ test/",
    "format:check": "oxfmt --check src/ test/",
    "lint": "oxlint src/ test/",
    "test": "bun test",
    "test:daytona:up": "test/daytona/compose.sh up -d",
    "test:daytona:down": "test/daytona/compose.sh down -v",
    "daytona:up": "daytona/compose.sh up -d",
    "daytona:down": "daytona/compose.sh down -v",
    "snapshot:build": "bun run snapshot/build.ts",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@daytona/sdk": "0.171.0",
    "@effect/platform": "0.95.0",
    "@effect/platform-bun": "0.85.0",
    "@effect/platform-node": "0.105.0",
    "effect": "3.20.0",
    "yaml": "2.8.4"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "bun-types": "1.3.13"
  }
}
