# Copy to apps/symphony-orchestrator/.env for local remote-Daytona work.
# Keep real secrets out of git. Host process env should override this file.

# Daytona Cloud. DAYTONA_API_KEY must stay host-only and must never be sent into
# sandbox env, repo files, logs, fp comments, PR text, or artifacts.
DAYTONA_API_KEY=
DAYTONA_API_URL=
DAYTONA_TARGET=
DAYTONA_SNAPSHOT=

# GitHub token for sandbox-side clone, branch push, PR creation, and PR
# babysitting. Use a scoped PAT or app token for this repository.
GITHUB_TOKEN=

# fp no-clone REST context for sandbox-side issue reads/writes.
FP_REMOTE=rest-api
FP_TOKEN=
FP_SERVER_URL=
FP_WORKSPACE=
FP_PROJECT_ID=
FP_PROJECT_PREFIX=

# Optional host Codex auth source. The implementation should copy only the
# minimal required auth material into a non-repo sandbox path.
SWITCHYARD_CODEX_AUTH=
