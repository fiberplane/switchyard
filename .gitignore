# Fiberplane local issue tracking — local DB and per-user state stay ignored,
# but project config + extensions ship with the repo so the workflow is
# reproducible for anyone cloning.
.fp/*
!.fp/config.toml
!.fp/extensions/
# tsconfig.json is generated by fp with a host-absolute path to the global
# extension types. Keep it out of git until the project takes a dep on
# @fiberplane/extensions instead.
.fp/extensions/tsconfig.json

# symphony artifacts
.symphony/

# Cloned upstream repos for agent reference
references/

# Dependencies
node_modules/

# Playground generated files and local smoke credentials
playgrounds/**/node_modules/
playgrounds/**/dist/
playgrounds/**/artifacts/
playgrounds/**/.env*
playgrounds/**/auth.json
playgrounds/**/codex-home/
playgrounds/**/.codex/
playgrounds/**/*.tgz
playgrounds/**/daytona-api-key*
playgrounds/**/*api-key*
playgrounds/**/*apikey*
playgrounds/**/*token*
playgrounds/**/*.pem
playgrounds/**/*.key
