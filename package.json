{
  "name": "@switchyard/root",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "playgrounds/*"
  ],
  "scripts": {
    "codegen": "bun run scripts/codex-ts-codegen.ts",
    "fallow": "fallow",
    "fallow:audit": "fallow audit",
    "fallow:dead-code": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:health": "fallow health",
    "lint": "oxlint",
    "lint:ast": "ast-grep scan",
    "lint:drift": "node scripts/drift-check.mjs",
    "test": "bun run --filter '*' test",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsgo --noEmit",
    "check": "bun run lint && bun run lint:ast && bun run lint:drift && bun run typecheck"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.42.0",
    "@types/bun": "^1.2.14",
    "@typescript/native-preview": "7.0.0-dev.20260401.1",
    "fallow": "2.82.0",
    "oxfmt": "0.43.0",
    "oxlint": "1.58.0"
  },
  "trustedDependencies": [
    "@ast-grep/cli"
  ]
}
